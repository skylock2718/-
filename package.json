{
  "name": "dicebound",
  "private": true,
  "version": "0.1.0",
  "description": "命骰远征 DICEBOUND — Roguelite Dice-Tactics Card Battler",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "npm run icons && vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "preact": "10.29.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "1.2.4",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.20.5",
    "@types/three": "0.170.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
